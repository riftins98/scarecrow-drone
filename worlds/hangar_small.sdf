    <!-- Lightweight lighting profile, same as the optimized full-size map. -->
    <light name="light_bay_left" type="point">
      <pose>-4 0 7.8 0 0 0</pose><cast_shadows>false</cast_shadows>
      <intensity>1.2</intensity><diffuse>0.95 0.95 0.95 1</diffuse><specular>0.15 0.15 0.15 1</specular>
      <attenuation><range>16</range><linear>0.04</linear><constant>0.7</constant><quadratic>0.003</quadratic></attenuation>
    </light>
    <light name="light_bay_right" type="point">
