# Toolchain pins for the Scarecrow sim image.
#
# WHY THIS FILE EXISTS
# On 2026-06-20 a single `brew upgrade` moved protobuf to 35 (breaking the PX4
# -Werror build) and removed assimp entirely (Gazebo could not start at all).
# Nothing in the repo changed; the host toolchain moved underneath it.
# Homebrew has no lockfile. apt on a digest-pinned base image does.
#
# Update these values deliberately, never automatically. Changing either one
# means re-running the full validation ladder (Mac -> Windows -> ROG).

# ubuntu:24.04 (noble), resolved 2026-07-31
UBUNTU_DIGEST=sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90

# gz-harmonic from packages.osrfoundation.org ubuntu-stable/noble.
# Confirmed available for BOTH arm64 and amd64.
GZ_VERSION=1.0.0-1~noble
