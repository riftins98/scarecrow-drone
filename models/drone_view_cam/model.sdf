<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='drone_view_cam'>
    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="drone_view_camera_link">
      <inertial>
        <mass>0.0001</mass>
        <inertia>
          <ixx>0.00000001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00000001</iyy>
          <iyz>0</iyz>
          <izz>0.00000001</izz>
        </inertia>
      </inertial>
      <sensor name="drone_view_camera" type="camera">
        <gz_frame_id>drone_view_camera_link</gz_frame_id>
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.74</horizontal_fov>
          <image>
            <width>960</width>
            <height>540</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
      </sensor>
      <gravity>false</gravity>
      <velocity_decay />
    </link>
  </model>
</sdf>
