<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='drone_view_cam'>
    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="drone_view_camera_link">
      <inertial>
        <mass>0.0001</mass>
        <inertia>
          <ixx>0.00000001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00000001</iyy>
          <iyz>0</iyz>
          <izz>0.00000001</izz>
        </inertia>
      </inertial>
      <sensor name="drone_view_camera" type="camera">
        <gz_frame_id>drone_view_camera_link</gz_frame_id>
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.74</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>
          <visibility_mask>3</visibility_mask>
        </camera>
        <always_on>1</always_on>
        <!-- Sim-time rate, so wall-clock delivery is update_rate x RTF. At the
             measured RTF (~0.7) this yields ~10 Hz, matching the streamer's
             fps setting of 10: every rendered frame reaches the browser and
             none are rendered only to be discarded. Raising this does NOT
             sharpen the picture. Resolution and encoder bitrate do that; this
             only costs render time. -->
        <update_rate>15</update_rate>
        <visualize>false</visualize>
      </sensor>
      <gravity>false</gravity>
      <velocity_decay />
    </link>
  </model>
</sdf>
